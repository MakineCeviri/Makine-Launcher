    "files": [
      {
        "path": "Content/Dialog/*.txt",
        "format": "txt",
        "encoding": "utf-8-bom"
      },
      {
        "path": "Celeste_Data/StreamingAssets/**/*.txt",
        "format": "txt",
        "encoding": "utf-8"
      }
    ],
    "encoding": "utf-8-bom",
    "extractionRules": [
      {
        "pattern": "^([A-Z_]+)=(.+)$",
        "sourceGroup": 1,
        "targetGroup": 2,
        "type": "key_value"
      }
    ]
  },
  "translation": {
    "source": "official",
    "stringCount": 3200,
    "coverage": "100%",
    "quality": "professional"
  },
  "patch": {
    "type": "file_replace",
    "requiresBackup": true,
    "steps": [
      {
        "order": 1,
        "action": "backup",
        "target": "Content/Dialog/*.txt"
      },
      {
        "order": 2,
        "action": "extract",
        "target": "Content/Dialog/*.txt"
      },
      {
        "order": 3,
        "action": "translate",
        "target": "Content/Dialog/*.txt"
      },
      {
        "order": 4,
