// Application icon
IDI_ICON1 ICON "app_icon.ico"

// Application manifest (DPI awareness, UTF-8, visual styles, segment heap)
// RT_MANIFEST = 24
1 24 "app.manifest"

// Version information embedded in EXE properties
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041F04B0"
        BEGIN
            VALUE "CompanyName",      "MakineAI Team"
            VALUE "FileDescription",  "MakineAI"
            VALUE "FileVersion",      "0.1.0"
            VALUE "InternalName",     "MakineAI"
            VALUE "LegalCopyright",   "\x00A9 2026 MakineAI Team"
            VALUE "OriginalFilename", "MakineAI.exe"
            VALUE "ProductName",      "MakineAI"
            VALUE "ProductVersion",   "0.1.0pre-alpha"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x041F, 1200
    END
END
