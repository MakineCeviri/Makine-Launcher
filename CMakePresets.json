{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "vcpkg-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "vcpkg-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "core-debug",
      "displayName": "Core Debug",
      "description": "Build core library in debug mode",
      "inherits": "windows-base",
      "generator": "Ninja",
      "sourceDir": "${sourceDir}/core",
      "binaryDir": "${sourceDir}/build/core-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "core-release",
      "displayName": "Core Release",
      "description": "Build core library in release mode",
      "inherits": "windows-base",
      "generator": "Ninja",
      "sourceDir": "${sourceDir}/core",
      "binaryDir": "${sourceDir}/build/core-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "qml-debug",
      "displayName": "QML Debug",
      "description": "Build QML application in debug mode",
      "inherits": "windows-base",
      "generator": "Ninja",
      "sourceDir": "${sourceDir}/qml",
      "binaryDir": "${sourceDir}/build/qml-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$env{Qt6_DIR}"
      }
    },
    {
      "name": "qml-release",
      "displayName": "QML Release",
      "description": "Build QML application in release mode",
      "inherits": "windows-base",
      "generator": "Ninja",
      "sourceDir": "${sourceDir}/qml",
      "binaryDir": "${sourceDir}/build/qml-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "$env{Qt6_DIR}"
      }
    },
    {
      "name": "vs2022-core",
      "displayName": "VS2022 Core",
      "description": "Visual Studio 2022 for core library",
      "inherits": "vcpkg-base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "sourceDir": "${sourceDir}/core",
      "binaryDir": "${sourceDir}/build/vs2022-core"
    },
    {
      "name": "vs2022-qml",
      "displayName": "VS2022 QML",
      "description": "Visual Studio 2022 for QML app",
      "inherits": "vcpkg-base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "sourceDir": "${sourceDir}/qml",
      "binaryDir": "${sourceDir}/build/vs2022-qml",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{Qt6_DIR}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "core-debug",
      "configurePreset": "core-debug"
    },
    {
      "name": "core-release",
      "configurePreset": "core-release"
    },
    {
      "name": "qml-debug",
      "configurePreset": "qml-debug"
    },
    {
      "name": "qml-release",
      "configurePreset": "qml-release"
    }
  ],
  "testPresets": [
    {
      "name": "core-tests",
      "configurePreset": "core-debug",
      "output": {
        "outputOnFailure": true,
        "verbosity": "verbose"
      }
    }
  ]
}
